{
  "name": "@transglot/sketch-plugin",
  "version": "0.1.1",
  "description": "Sketch plugin for transglot: push selected text layers to a project, translate with AI, and pull the translations back onto the layers.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.1",
    "@typescript-eslint/eslint-plugin": "^8.18",
    "@typescript-eslint/parser": "^8.18",
    "esbuild": "^0.28",
    "eslint": "^9.17",
    "typescript": "^6.0",
    "vitest": "^4"
  }
}
